# Example environment variables for notes_app_backend
# Copy to .env and adjust values in deployment environments.

# Optional: Override server port
# SERVER_PORT=8080

# Database (using in-memory H2 by default; for production use an external DB and set proper properties)
# SPRING_DATASOURCE_URL=jdbc:postgresql://host:5432/notes
# SPRING_DATASOURCE_USERNAME=notes_user
# SPRING_DATASOURCE_PASSWORD=change_me

# JPA settings
# SPRING_JPA_HIBERNATE_DDL_AUTO=update
